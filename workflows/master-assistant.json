{
  "name": "Final Master AI Email Assistant",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyX",
              "value": 5,
              "unit": "minutes"
            }
          ]
        },
        "filters": {
          "readStatus": "unread"
        },
        "options": {}
      },
      "id": "d1b2c3d4-0001-4000-8000-000000000001",
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1,
      "position": [100, 300],
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Gmail OAuth2"
        }
      }
    },
    {
      "parameters": {
        "operation": "markAsRead",
        "messageId": "={{ $json.id }}"
      },
      "id": "d1b2c3d4-0002-4000-8000-000000000002",
      "name": "Mark as Read",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [300, 300],
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Gmail OAuth2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const email = $input.item.json;\nreturn [{\n  json: {\n    messageId: email.id,\n    from: email.from,\n    subject: email.subject || '(no subject)',\n    body: (email.text || email.snippet || '').substring(0, 2000),\n    date: email.date\n  }\n}];"
      },
      "id": "d1b2c3d4-0003-4000-8000-000000000003",
      "name": "Preprocess Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"temperature\": 0.1,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are an email classification assistant. \\n\\nClassify into: urgent, support, sales, spam.\\nExtract: sentiment, summary, suggested_action, confidence.\\n\\nYOU MUST RESPOND ONLY WITH A RAW JSON OBJECT STARTING WITH { AND ENDING WITH }. NO TEXT.\\n\\nSchema: {\\\"category\\\":\\\"urgent|support|sales|spam\\\",\\\"sentiment\\\":\\\"positive|neutral|negative\\\",\\\"summary\\\":\\\"string\\\",\\\"suggested_action\\\":\\\"string\\\",\\\"confidence\\\":0.95}\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"From: {{ $json.from }}\\nSubject: {{ $json.subject }}\\nBody: {{ $json.body }}\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "d1b2c3d4-0004-4000-8000-000000000004",
      "name": "Groq Classify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [700, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Groq API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.item.json.choices?.[0]?.message?.content || '{}';\n\n// Strip markdown fences if present\nlet cleaned = raw.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n\n// Try to extract JSON if surrounded by text\nif (!cleaned.startsWith('{')) {\n  const match = cleaned.match(/\\{[\\s\\S]*\\}/);\n  if (match) cleaned = match[0];\n}\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = {\n    category: 'unknown',\n    sentiment: 'neutral',\n    summary: 'AI parsing failed — manual review needed',\n    suggested_action: 'Review email manually',\n    confidence: 0\n  };\n}\n\nconst upstream = $('Preprocess Email').item.json;\nreturn [{\n  json: {\n    ...upstream,\n    category: (parsed.category || 'unknown').toLowerCase().trim(),\n    sentiment: (parsed.sentiment || 'neutral').toLowerCase(),\n    summary: parsed.summary || '',\n    suggested_action: parsed.suggested_action || '',\n    confidence: parsed.confidence || 0,\n    processedAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "d1b2c3d4-0005-4000-8000-000000000005",
      "name": "Parse AI Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": false
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.category }}",
                    "rightValue": "urgent",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "urgent"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.category }}",
                    "rightValue": "support",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "support"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.category }}",
                    "rightValue": "sales",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "sales"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.category }}",
                    "rightValue": "spam",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "spam"
            }
          ]
        },
        "options": {}
      },
      "id": "d1b2c3d4-0006-4000-8000-000000000006",
      "name": "Route by Category",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [1100, 300]
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "create",
        "databaseId": {
          "__rl": true,
          "mode": "id",
          "value": "REPLACE_WITH_YOUR_NOTION_DATABASE_ID"
        },
        "propertiesUi": {
          "propertyValues": [
            {
              "key": "Subject",
              "type": "title",
              "title": "={{ $json.subject }}"
            },
            {
              "key": "From",
              "type": "richText",
              "richText": "={{ $json.from }}"
            },
            {
              "key": "Category",
              "type": "select",
              "select": "={{ $json.category }}"
            },
            {
              "key": "Summary",
              "type": "richText",
              "richText": "={{ $json.summary }}"
            }
          ]
        }
      },
      "id": "d1b2c3d4-0007-4000-8000-000000000007",
      "name": "Notion Dashboard",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2,
      "position": [1500, 100],
      "credentials": {
        "notionApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Notion API"
        }
      }
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "value": "REPLACE_WITH_YOUR_SPREADSHEET_ID"
        },
        "sheetName": {
          "value": "Email Log"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Subject": "={{ $json.subject }}",
            "Category": "={{ $json.category }}",
            "Summary": "={{ $json.summary }}"
          }
        }
      },
      "id": "d1b2c3d4-0008-4000-8000-000000000008",
      "name": "Google Sheets Log",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [1500, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Google Sheets OAuth2"
        }
      }
    }
  ],
  "connections": {
    "Gmail Trigger": {
      "main": [[{ "node": "Mark as Read", "type": "main", "index": 0 }]]
    },
    "Mark as Read": {
      "main": [[{ "node": "Preprocess Email", "type": "main", "index": 0 }]]
    },
    "Preprocess Email": {
      "main": [[{ "node": "Groq Classify", "type": "main", "index": 0 }]]
    },
    "Groq Classify": {
      "main": [[{ "node": "Parse AI Response", "type": "main", "index": 0 }]]
    },
    "Parse AI Response": {
      "main": [[{ "node": "Route by Category", "type": "main", "index": 0 }]]
    },
    "Route by Category": {
      "main": [
        [{ "node": "Google Sheets Log", "type": "main", "index": 0 }, { "node": "Notion Dashboard", "type": "main", "index": 0 }],
        [{ "node": "Google Sheets Log", "type": "main", "index": 0 }, { "node": "Notion Dashboard", "type": "main", "index": 0 }],
        [{ "node": "Google Sheets Log", "type": "main", "index": 0 }, { "node": "Notion Dashboard", "type": "main", "index": 0 }],
        [{ "node": "Google Sheets Log", "type": "main", "index": 0 }, { "node": "Notion Dashboard", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "pinData": {},
  "staticData": null,
  "tags": ["email", "ai", "automation", "groq", "notion"]
}
