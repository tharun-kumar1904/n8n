    {
      "parameters": {
        "jsCode": "// ============================================================\n// Email Preprocessor\n// Strips HTML, truncates body, extracts clean metadata\n// ============================================================\n\nconst email = $input.item.json;\n\nfunction stripHtml(html) {\n  return (html || '')\n    .replace(/<style[^>]*>[\\s\\S]*?<\\/style>/gi, '')\n    .replace(/<script[^>]*>[\\s\\S]*?<\\/script>/gi, '')\n    .replace(/<[^>]+>/g, ' ')\n    .replace(/&nbsp;/g, ' ')\n    .replace(/&amp;/g, '&')\n    .replace(/&lt;/g, '<')\n    .replace(/&gt;/g, '>')\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\nfunction parseEmail(raw) {\n  const match = (raw || '').match(/<([^>]+)>/);\n  return match ? match[1] : (raw || '');\n}\n\nconst rawBody = email.text || email.html || email.snippet || '';\nconst cleanBody = stripHtml(rawBody).substring(0, 1500);\n\nreturn [{\n  json: {\n    messageId: email.id,\n    threadId: email.threadId,\n    from: email.from,\n    fromEmail: parseEmail(email.from),\n    to: email.to,\n    subject: email.subject || '(no subject)',\n    body: cleanBody,\n    snippet: email.snippet || '',\n    date: email.date,\n    receivedAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "b1b2c3d4-0003-4000-8000-000000000003",
      "name": "Preprocess Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"temperature\": 0.1,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are an email classification assistant for a SaaS startup.\\n\\nClassify the incoming email into exactly one category:\\n- urgent: needs response within 1 hour (outages, legal, angry enterprise customer threatening churn)\\n- support: customer needs help (setup, bugs, how-to, billing)\\n- sales: prospect or partner interest (pricing, demo request, partnership)\\n- spam: no action needed (newsletters, marketing, automated notifications)\\n\\nAlso extract:\\n- sentiment: positive | neutral | negative\\n- summary: 1-2 sentences describing the core message\\n- suggested_action: one concrete action the team should take\\n- confidence: 0.0 to 1.0\\n\\nRespond ONLY with valid JSON. No preamble. Schema:\\n{\\\"category\\\":\\\"urgent|support|sales|spam\\\",\\\"sentiment\\\":\\\"positive|neutral|negative\\\",\\\"summary\\\":\\\"string\\\",\\\"suggested_action\\\":\\\"string\\\",\\\"confidence\\\":0.95}\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"From: {{ $json.from }}\\nSubject: {{ $json.subject }}\\nBody: {{ $json.body }}\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "b1b2c3d4-0004-4000-8000-000000000004",
      "name": "Groq AI Classify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [850, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Groq API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// ============================================================\n// Parse and validate AI JSON response\n// Merges classification with upstream email data\n// ============================================================\n\nconst raw = $input.item.json.choices?.[0]?.message?.content || '';\n\n// Strip markdown code fences if present\nlet cleaned = raw\n  .replace(/```json\\n?/g, '')\n  .replace(/```\\n?/g, '')\n  .trim();\n\n// Try to extract JSON if surrounded by text\nif (!cleaned.startsWith('{')) {\n  const match = cleaned.match(/\\{[\\s\\S]*\\}/);\n  if (match) cleaned = match[0];\n}\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  // Fallback on parse failure — route to manual review\n  parsed = {\n    category: 'unknown',\n    sentiment: 'neutral',\n    summary: 'AI parsing failed — needs manual review',\n    suggested_action: 'Review email manually in Gmail',\n    confidence: 0\n  };\n}\n\n// Get upstream data from Preprocess node\nconst upstream = $('Preprocess Email').item.json;\n\nreturn [{\n  json: {\n    // Email metadata\n    messageId: upstream.messageId,\n    threadId: upstream.threadId,\n    from: upstream.from,\n    fromEmail: upstream.fromEmail,\n    subject: upstream.subject,\n    body: upstream.body,\n    date: upstream.date,\n    receivedAt: upstream.receivedAt,\n    // AI classification\n    category: (parsed.category || 'unknown').toLowerCase().trim(),\n    sentiment: (parsed.sentiment || 'neutral').toLowerCase(),\n    summary: parsed.summary || '',\n    suggested_action: parsed.suggested_action || '',\n    confidence: parsed.confidence || 0,\n    // Meta\n    processedAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "b1b2c3d4-0005-4000-8000-000000000005",
      "name": "Parse AI Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1050, 300]
    },
