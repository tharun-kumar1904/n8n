        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"temperature\": 0.7,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a friendly, professional customer support agent for a SaaS platform.\\n\\nWrite a helpful reply to the customer's email. Rules:\\n1. Address them by first name if available\\n2. Acknowledge their specific issue — show you read it\\n3. Provide a clear, actionable solution or next step\\n4. Be concise — 3-5 sentences max\\n5. End with an open offer to help further\\n6. Sign off as 'The Support Team'\\n\\nTone: Warm but professional. Never robotic. Never over-apologetic.\\nOutput the reply text only. No subject line, no metadata.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Customer email:\\nFrom: {{ $json.from }}\\nSubject: {{ $json.subject }}\\nBody: {{ $json.body }}\\n\\nIssue summary: {{ $json.summary }}\"\n    }\n  ]\n}",
        "options": {}
